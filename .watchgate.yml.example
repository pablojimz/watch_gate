# Copiar como .watchgate.yml en la raíz del repositorio a analizar.
# Ver docs/WatchGate_spec_implementacion_IA.md §0 (config.py) y memoria, Anexo técnico A.2, A.0.0, A.3.3.

# Pesos por capa (deben sumar 1; si una capa se desactiva con peso 0,
# las restantes se renormalizan para conservar la escala 0-100).
weights:
  static: 0.25          # Semgrep / YARA sobre el código modificado
  dependencies: 0.20    # OSV, typosquatting, CVEs conocidas
  reputation: 0.15      # Identidad declarada vs. historial real de la cuenta
  semantic: 0.40        # LLM + RAG local sobre la intención del cambio

# Umbrales del semáforo de riesgo (0-100)
thresholds:
  yellow: 31   # >= 31 -> riesgo medio, revisión humana reforzada
  red: 66      # >= 66 -> riesgo alto

# Si es true, bloquea el merge cuando el resultado es rojo
block_on_red: true

# Cortocircuitos en extremos de riesgo (A.3.4, objetivo ampliado)
shortcircuit_enabled: false
audit_sampling: 0.05   # fracción de PRs que igualmente se envían a la capa semántica

# Control de coste de tokens en la capa semántica (A.3.3)
semantic:
  max_diff_tokens: 6000
  monthly_budget_tokens: null   # null = sin límite
  cache_identical_diffs: true

# Configuración de API de GitHub (opcional)
github_token: null            # Token de GitHub (PAT) para aumentar la cuota a 5.000 req/h
github_api_url: "https://api.github.com"
