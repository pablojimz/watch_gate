# Copia este fichero a .env (ya está en .gitignore, nunca se comitea) y
# rellena los valores reales ahí. La CLI (`watchgate analyze`) y la configuración
# (`WatchGateConfig`) cargan automáticamente las variables con prefijo WATCHGATE_*.
# Si exportas variables desde un archivo .env manualmente en tu consola:
#   set -a && source .env && set +a

# ==============================================================================
# Seguridad y Cifrado
# ==============================================================================
# Clave simétrica Fernet de 32 bytes (base64 url-safe) para cifrar secretos 
# en la base de datos (como custom_llm_api_key o vcs_access_token).
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WATCHGATE_DB_SECRET="your-32-byte-fernet-key-here="

# Secreto para validar los webhooks entrantes de GitHub App (HMAC SHA-256)
WATCHGATE_GITHUB_WEBHOOK_SECRET="your-webhook-secret-here"

# --- VCS / GitHub API --------------------------------------------------------
# Token de GitHub (PAT) de fallback para elevar la cuota de peticiones HTTP
# de 60 req/h a 5.000 req/h al escanear repositorios externos.
WATCHGATE_GITHUB_TOKEN=
# URL base de la API de GitHub (por defecto https://api.github.com, o URL privada para GitHub Enterprise)
WATCHGATE_GITHUB_API_URL=https://api.github.com

# --- Logging (Engine API / Dashboard backend) -------------------------------
# json: una línea JSON por evento (service/timestamp/level/logger/message),
# grepable/parseable por un agregador real -- recomendado en producción
# (docker-compose.prod.yml ya lo activa). text (por defecto): más legible
# arrancando en local a mano. Ver watchgate/logging_config.py.
WATCHGATE_LOG_FORMAT=text
WATCHGATE_LOG_LEVEL=INFO

# --- Alerting (Engine API / Dashboard backend) -------------------------------
# Opcional: si se rellena, ambos servicios envían a Sentry las excepciones no
# manejadas de verdad (antes, la única forma de enterarse de un fallo en
# producción era leer `docker compose logs` a mano). Sin esta variable, ni
# siquiera se importa `sentry_sdk` -- cero coste si no se usa. Configurado
# deliberadamente sin capturar logs (solo excepciones) ni variables locales
# de los tracebacks, para no arriesgar que un secreto (token de GitHub, clave
# de LLM) acabe en un evento de Sentry -- ver watchgate/logging_config.py::
# configure_sentry.
WATCHGATE_SENTRY_DSN=
WATCHGATE_SENTRY_ENVIRONMENT=production
WATCHGATE_SENTRY_RELEASE=

# Proveedor de LLM para la capa semántica: anthropic | gemini | local
WATCHGATE_LLM_PROVIDER=anthropic

# Key del proveedor cloud elegido (Anthropic o Gemini; no aplica a "local")
WATCHGATE_LLM_API_KEY=

# Opcional: fuerza un modelo concreto (si no, cada proveedor usa su default)
WATCHGATE_LLM_MODEL=

# Opcional: temperatura de muestreo del LLM. Por defecto 0.0 (determinista) a
# propósito -- la capa semántica usa el LLM como clasificador estructurado
# (risk_score/categoría/justificación), no para generación creativa, y
# cualquier valor > 0 introduce varianza entre ejecuciones del mismo PR justo
# donde más duele: un score cerca de un umbral de semáforo podría cruzarlo o
# no según la tirada. Sube esto solo si tienes un motivo concreto.
WATCHGATE_LLM_TEMPERATURE=0.0

# Solo si WATCHGATE_LLM_PROVIDER=local: URL del servidor OpenAI-compatible
# (Ollama, llama.cpp server, LM Studio, vLLM...). Por defecto, Ollama local.
# Para servir un modelo con vLLM en una máquina con GPU (recomendado para
# comparar modelos en serio, no solo probar en un portátil): ver
# docs/despliegue_gpu_modelos_locales.md -- normalmente será
# http://localhost:8000/v1 en vez del puerto de Ollama.
WATCHGATE_LLM_BASE_URL=http://localhost:11434/v1

# Solo si WATCHGATE_LLM_PROVIDER=local: timeout en segundos por llamada HTTP
# al servidor local. Por defecto 120s (más que los proveedores cloud, donde
# 60s de red sobra) -- un modelo local grande comparte GPU con lo que sea
# que corra al lado, y el cuello de botella es cómputo, no red. Reproducido
# en vivo: qwen3.6:27b superaba los 60s en diffs grandes/con varias tool
# calls y la capa semántica se marcaba "skipped" por timeout justo en los
# casos más difíciles, no por peor razonamiento. Súbelo más si tu GPU es
# compartida/modesta.
WATCHGATE_LLM_TIMEOUT_SECONDS=120

# Opcional: si se rellena, la capa semántica gana la tool check_file_reputation
# (consulta de hash en VirusTotal). Sin ella, esa tool no se ofrece al LLM.
WATCHGATE_VT_API_KEY=

# --- RAG dinámico -------------------------------------------------------------
# Cada cuántas horas el dashboard-backend encola en el worker un sync de
# avisos de seguridad reales (GitHub Security Advisories, type=malware) al
# corpus del RAG + reindexado si hubo cambios. También se encola uno al
# arrancar. 0 (o negativo) lo desactiva. El sync manual sigue disponible:
# `watchgate rag sync-cves`.
WATCHGATE_RAG_SYNC_INTERVAL_HOURS=24

# --- Dashboard (A.4) ----------------------------------------------------------
# SQLite local por defecto (fichero, se crea solo). Para Postgres, rellena
# WATCHGATE_DASHBOARD_DATABASE_URL (postgresql://user:pass@host:5432/db) --
# si está presente, tiene prioridad sobre WATCHGATE_DASHBOARD_DB. Requiere
# tener el driver instalado (ya es dependencia del proyecto: psycopg).
WATCHGATE_DASHBOARD_DB=.watchgate/dashboard.db
WATCHGATE_DASHBOARD_DATABASE_URL=
# Opcional: rate limiting de /api/auth/login compartido entre réplicas
# (redis://host:6379/0). Sin ella, el límite es por proceso -- protege
# igual con una sola réplica, pero cada una lleva su propio contador si se
# despliega con más de una.
WATCHGATE_REDIS_URL=
# En producción: WATCHGATE_DASHBOARD_DEV_MODE=0 exige un secreto propio aquí
# (no "change-me-in-production" ni vacío) o el proceso se niega a arrancar --
# ver ensure_safe_startup_config() en auth.py.
WATCHGATE_DASHBOARD_SECRET=change-me-in-production
# En producción (DEV_MODE=0): la cookie de sesión puede llevar embebido un
# token de acceso de GitHub (cifrado, pero el flag Secure sigue haciendo
# falta para que la propia cookie no viaje en claro sobre HTTP) -- fijar a
# "1" es obligatorio o el proceso se niega a arrancar, igual que el secreto.
# Requiere servir el dashboard por HTTPS de verdad.
WATCHGATE_DASHBOARD_SECURE_COOKIE=0
WATCHGATE_DASHBOARD_DEV_MODE=1
# Cierra específicamente POST /api/auth/dev-login (crear sesión con solo un
# usuario, sin contraseña) sin activar el resto de exigencias de DEV_MODE=0
# (token de ingesta, cookie Secure -- requieren HTTPS delante). Útil en un
# despliegue real sin reverse proxy TLS donde aun así se quiere exigir
# contraseña para entrar. Ver _dev_login_enabled() en auth.py.
WATCHGATE_DASHBOARD_DISABLE_DEV_LOGIN=0
WATCHGATE_DASHBOARD_SEED=1
WATCHGATE_DASHBOARD_FRONTEND_ORIGIN=http://localhost:5173
WATCHGATE_DASHBOARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Token compartido para POST /api/scores (ingesta desde la Action, sin cookie
# de usuario -- ver require_ingest_token() en auth.py). Igual que el secreto
# de sesión: en producción (DEV_MODE=0) es obligatorio, o el proceso no
# arranca.
WATCHGATE_DASHBOARD_INGEST_TOKEN=

# --- Adaptador GitHub Action <-> Dashboard (spec §12, pasos 8 y config) -------
# Opcional: si se rellena, la Action (a) persiste cada resultado en el
# dashboard (POST {URL}/api/scores) además de comentar en el PR, y (b) antes
# de analizar, aplica los pesos/umbrales/capas activas/política de bloqueo y
# presupuesto de LLM configurados para ese repo en el dashboard (GET
# {URL}/api/repos/{repo}/ci-config), por encima de lo que diga .watchgate.yml.
# Si no se rellena, o el dashboard no responde, la Action funciona igual con
# .watchgate.yml tal cual -- el dashboard nunca es un requisito para que la
# Action complete su trabajo.
WATCHGATE_DASHBOARD_URL=
# Mismo valor que WATCHGATE_DASHBOARD_INGEST_TOKEN del backend del dashboard.
# WATCHGATE_DASHBOARD_INGEST_TOKEN=

# GitHub OAuth (opcional si usas login de desarrollo)
WATCHGATE_GITHUB_CLIENT_ID=
WATCHGATE_GITHUB_CLIENT_SECRET=
WATCHGATE_GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# OIDC genérico Auth0/Keycloak (opcional)
WATCHGATE_OIDC_CLIENT_ID=
WATCHGATE_OIDC_CLIENT_SECRET=
WATCHGATE_OIDC_ISSUER=
WATCHGATE_OIDC_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback

# --- Backups de Postgres a S3 (solo docker-compose.prod.yml, opcional) -------
# Sin WATCHGATE_BACKUP_S3_BUCKET, el backup diario (postgres-backup) se queda
# solo en el volumen local (postgres_backups) -- protege de un error humano/
# de aplicación, pero no de perder la máquina entera. Con la variable puesta,
# cada backup se sube además a un bucket S3 (o cualquier proveedor
# compatible -- MinIO, Backblaze B2, Wasabi, Cloudflare R2...) vía rclone.
# Ver docs/despliegue.md -- sección "Copia fuera de la máquina (S3 o compatible)".
WATCHGATE_BACKUP_S3_BUCKET=
WATCHGATE_BACKUP_S3_PREFIX=watchgate-backups
WATCHGATE_BACKUP_S3_REGION=us-east-1
# Vacío = S3 real de AWS. Relleno = endpoint de un proveedor S3-compatible.
WATCHGATE_BACKUP_S3_ENDPOINT=
# Vacío = "AWS" si no hay endpoint propio, "Minio" si lo hay -- fuerza un
# valor concreto si tu proveedor lo necesita explícito (p. ej. "Wasabi").
WATCHGATE_BACKUP_S3_PROVIDER=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
