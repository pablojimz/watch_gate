{$WATCHGATE_DOMAIN:localhost} {
	# Engine API SaaS (agentes de IA, GitHub Action externa) -- ver
	# watchgate/api/main.py, prefijo real de todas sus rutas públicas.
	@api path /api/v1/*
	handle @api {
		encode gzip
		reverse_proxy engine-api:8080
	}

	# SSE de refresco en vivo del Dashboard (ver
	# dashboard/backend/live_events.py) -- nunca gzip aquí: un stream de
	# eventos pequeños e infrecuentes se quedaría atascado en el buffer
	# del compresor en vez de llegar al navegador al instante. `encode`
	# está declarado dentro de cada `handle` (no a nivel de sitio) para
	# poder excluir justo este uno sin tocar los demás.
	# "**" (no "*"): el repo es "owner/repo" -- dos segmentos de ruta, y
	# "*" en el matcher de Caddy no cruza "/".
	@dashboard_events path /api/repos/**/events
	handle @dashboard_events {
		reverse_proxy dashboard-frontend:80
	}

	# Todo lo demás va al frontend del Dashboard, que a su vez ya sabe
	# reenviar /api/* (su propio backend, no el de la Engine API) a
	# dashboard-backend:8000 -- ver
	# watchgate/dashboard/frontend/docker/nginx.conf.template.
	handle {
		encode gzip
		reverse_proxy dashboard-frontend:80
	}
}
