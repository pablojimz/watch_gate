# Plantilla procesada por envsubst al arrancar el contenedor (mecanismo
# nativo de la imagen oficial nginx:alpine sobre /etc/nginx/templates/) --
# ${BACKEND_ORIGIN} se sustituye por la variable de entorno del mismo
# nombre. No usar otras variables ${...} en este fichero sin extenderlas
# explícitamente en NGINX_ENVSUBST_OUTPUT_DIR/entrypoint, o envsubst
# intentará sustituirlas también.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA: cualquier ruta que no sea un fichero real cae en index.html
    # (react-router resuelve la navegación en el cliente).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Mismo prefijo que el proxy de Vite en dev (vite.config.ts) -- el
    # código del frontend llama a rutas relativas /api/... sin conocer la
    # URL del backend, así que en producción nginx tiene que reenviarlas.
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Cookies de sesión (httponly, SameSite=Lax) deben viajar intactas.
        proxy_pass_request_headers on;
    }
}
